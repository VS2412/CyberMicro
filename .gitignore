# ---------------------------------------------------------------
dist/
dist-ssr/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.vite/
*.local
*.tsbuildinfo

# Big raw downloads (we only commit the compact attack.min.json)
enterprise-attack.json

# Exported reports / evidence created while testing (keep demo-evidence/)
Watchman-*.pdf
watchman-*-attack-layer.json

