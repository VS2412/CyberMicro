{
  "fields": [
    { "key": "nature_of_breach", "label": "Nature of the incident / breach", "type": "textarea", "aiDraftable": true, "help": "What happened, how, and when, in plain language." },
    { "key": "data_categories", "label": "Categories of personal data affected", "type": "text", "help": "e.g. names, contact details, IBAN, account balances, date of birth" },
    { "key": "approx_subjects", "label": "Approximate number of people affected", "type": "number", "help": "Data subjects / data principals. An estimate is acceptable at first (GDPR Art. 33(4))." },
    { "key": "approx_records", "label": "Approximate number of records affected", "type": "number" },
    { "key": "dpo_contact", "label": "DPO / contact point details", "type": "text", "help": "Name and contact details of the Data Protection Officer or other contact point." },
    { "key": "likely_consequences", "label": "Likely consequences for individuals", "type": "textarea", "aiDraftable": true, "help": "e.g. fraud, phishing, identity theft, financial loss." },
    { "key": "measures_taken", "label": "Measures taken or proposed", "type": "textarea", "help": "Containment, remediation, and steps to mitigate harm to individuals." },
    { "key": "affected_services", "label": "Services / systems affected", "type": "text", "help": "Business services, ICT systems and functions impacted." },
    { "key": "clients_affected", "label": "Number of clients affected", "type": "number", "help": "DORA classification criterion." },
    { "key": "reporting_contact", "label": "Regulatory reporting contact", "type": "text", "help": "Person the regulator should contact about this notification." },
    { "key": "materiality_assessment", "label": "Material aspects: nature, scope, timing, impact", "type": "textarea", "help": "Required by Form 8-K Item 1.05; written by Legal." }
  ],
