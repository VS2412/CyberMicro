# Copy this file to ".env" (same folder) or run:  npm run setup   (inside watchman_1/server)
# Never commit the real .env: it is listed in .gitignore.

# Port the API server listens on
PORT=5000

# Database: the local MongoDB started with `npm run db`
MONGO_URI=mongodb://127.0.0.1:27017/watchman

NODE_ENV=development
LOG_LEVEL=info

# Secret key that seals the audit timeline (HMAC). `npm run setup` generates one.
# Changing it later makes existing timelines fail verification (by design).
CHAIN_SECRET=change-me

# 1 = show the demo controls (time machine, "Rogue DB edit"). 0 = hide them.
DEMO_MODE=1

# ----- AI model -----
# ollama = runs on this computer (default) | azure = Azure OpenAI / GitHub Models | gemini = Google Gemini
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini
# live = use the model (falls back automatically) | replay = use saved answers first | fallback = no AI at all
AI_MODE=live

# Only needed if LLM_PROVIDER=azure
AZURE_OPENAI_URL=
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
